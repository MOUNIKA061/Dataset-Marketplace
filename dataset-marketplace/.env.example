# ============================================================================
# Dataset Marketplace - Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env file to version control!
# ============================================================================

# ----------------------------------------------------------------------------
# Flask Settings
# ----------------------------------------------------------------------------

# Flask environment: development, production, or testing
FLASK_ENV=development

# Enable/disable debug mode (set to False in production)
FLASK_DEBUG=True

# Secret key for session signing and JWT tokens
# Generate a secure key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-this

# ----------------------------------------------------------------------------
# MySQL Database Settings
# For local MySQL installation or AWS RDS instance
# ----------------------------------------------------------------------------

# Database host - use localhost for local, or RDS endpoint for AWS
# Example RDS: your-db-instance.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com
MYSQL_HOST=localhost

# MySQL port (default: 3306)
MYSQL_PORT=3306

# Database username
MYSQL_USER=root

# Database password
MYSQL_PASSWORD=your_mysql_password

# Database name
MYSQL_DATABASE=dataset_marketplace

# ----------------------------------------------------------------------------
# AWS S3 Settings
# For storing dataset files in cloud storage
# ----------------------------------------------------------------------------

# AWS Access Key ID (from IAM user credentials)
# For local development only - use IAM roles in production
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY

# AWS Secret Access Key (from IAM user credentials)
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY

# AWS Region for S3 bucket
AWS_REGION=us-east-1

# S3 Bucket name (must be globally unique)
S3_BUCKET_NAME=your-dataset-marketplace-bucket

# ----------------------------------------------------------------------------
# JWT Settings
# ----------------------------------------------------------------------------

# JWT token expiration time in hours
JWT_EXPIRATION_HOURS=24

# ----------------------------------------------------------------------------
# Optional: AWS RDS Settings (for cloud deployment)
# ----------------------------------------------------------------------------

# If using AWS RDS, set MYSQL_HOST to your RDS endpoint:
# MYSQL_HOST=your-rds-instance.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com
# MYSQL_PORT=3306
# MYSQL_USER=admin
# MYSQL_PASSWORD=your-rds-password
# MYSQL_DATABASE=dataset_marketplace
